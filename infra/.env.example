# Bu dosyayı ".env" adıyla kopyalayın ve değerleri değiştirin.
# .env dosyası .gitignore ile Git dışında tutulur.
POSTGRES_DB=sosyal
POSTGRES_USER=sosyal
POSTGRES_PASSWORD=buraya-guclu-bir-yerel-parola-yazin
DB_PORT=5432

# İsteğe bağlı: tanımlanmazsa backend her açılışta geçici bir JWT anahtarı üretir
# (yeniden başlatınca oturumlar kapanır). Üretmek için: openssl rand -base64 48
JWT_SECRET=
