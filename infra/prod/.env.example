# Sunucuda "infra/prod/.env" olarak kopyalayın: cp infra/prod/.env.example infra/prod/.env
# Bu dosya Git'e eklenmez.

# API'nin yayınlanacağı adres. Alan adı yokken sunucu IP'sini tirelerle yazıp sslip.io ekleyin:
#   203.0.113.10  ->  203-0-113-10.sslip.io   (örnek IP; kendi IP'nizi yazın)
# Gerçek alan adı alındığında yalnızca bu satırı değiştirin (ör. api.siteniz.com).
API_DOMAIN=

POSTGRES_DB=sosyal
POSTGRES_USER=sosyal
# Uzun ve rastgele olmalı. Üretmek için: openssl rand -hex 24
POSTGRES_PASSWORD=

# Erişim belirteçlerini imzalayan anahtar (Base64, en az 32 bayt). deploy.sh boşsa otomatik üretir.
# Değiştirilirse tüm kullanıcıların oturumu kapanır.
JWT_SECRET=

# Web sitesi eklendiğinde origin'leri virgülle yazın. Boş bırakılırsa https://API_DOMAIN kullanılır.
CORS_ALLOWED_ORIGINS=
